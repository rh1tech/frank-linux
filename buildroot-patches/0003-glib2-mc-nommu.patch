diff --git a/package/mc/mc.mk b/package/mc/mc.mk
index 9401b8a1..4e8485f2 100644
--- a/package/mc/mc.mk
+++ b/package/mc/mc.mk
@@ -10,10 +10,57 @@ MC_SITE = http://ftp.midnight-commander.org
 MC_LICENSE = GPL-3.0+
 MC_LICENSE_FILES = COPYING
 MC_DEPENDENCIES = libglib2 host-pkgconf $(TARGET_NLS_DEPENDENCIES)
+# Two groups of things this board cannot have.
+#
+# Needs a copy of a running mc, which NOMMU cannot make:
+#   --disable-background  file operations that continue in a second copy of mc,
+#                         which goes on executing mc code rather than exec'ing
+#                         anything. That is the case fork() exists for.
+#
+# Needs a network, which this kernel does not have at all:
+#   --disable-vfs-ftp --disable-vfs-shell
+#
+# And one that is off because it has not been done, not because it cannot be:
+#   --without-subshell    mc keeps a real shell alive behind the panels over a
+#                         pty. init_subshell_child() does setsid, TIOCSCTTY,
+#                         tcsetattr, chdir and then execl's the shell -- all
+#                         syscalls, and after the exec it needs nothing of mc.
+#                         What stops it is that the child allocates before the
+#                         exec, and under vfork the heap is the parent's.
+#
+# Everything else stays: the panels, the internal viewer and editor, find-file,
+# and the tar and cpio filesystems, which mc reads in-process. External programs
+# work -- my_systemv() execs them through posix_spawn -- and so do the
+# popen-based paths, because uClibc's popen() already uses vfork().
+MC_CONF_OPTS += \
+	--without-subshell \
+	--disable-background \
+	--disable-vfs-ftp \
+	--disable-vfs-shell
+
 MC_CONF_ENV = \
 	CFLAGS="$(TARGET_CFLAGS) -std=c99" \
 	LIBS=$(TARGET_NLS_LIBS)
 
+# A stack big enough for it.
+#
+# NOMMU has no stack guard page and no growth: the kernel allocates exactly what
+# PT_GNU_STACK asks for, and anything past it lands on whatever is next. The
+# default is 32 kB, which mc overruns during start-up. The symptom is not a
+# stack message but a wild pointer, because the overrun corrupts a saved one:
+#
+#   mc[34]: MPU fault, data access at 0x2a2e2500 (MMFSR 0x82)
+#   Segmentation fault
+#
+# 0x2a2e2500 is the bytes of the string "*.%" -- what a smashed frame looks like
+# when a char* ends up where a pointer was expected.
+#
+# 256 kB rather than nano's 128 kB: mc is several times the program and its
+# find-file and directory scanning recurse. Not free -- on NOMMU this is one
+# contiguous allocation, and large ones fail first as memory fragments -- but a
+# machine with 5.5 MB free can afford it, and an overflow here is silent.
+MC_CONF_ENV += LDFLAGS="$(TARGET_LDFLAGS) -Wl,-z,stack-size=262144"
+
 ifeq ($(BR2_PACKAGE_GPM),y)
 MC_CONF_OPTS += --with-gpm-mouse
 MC_DEPENDENCIES += gpm
