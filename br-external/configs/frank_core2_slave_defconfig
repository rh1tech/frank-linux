# Phase 4: ARM NOMMU Linux on the FRANK Core 2 Proto slave half.
#
# Same toolchain, C library and binary format as the QEMU target, which is the
# point of having had a QEMU target: the only new things here are a machine, a
# timer, a console and the atomics option actually being switched on.

# Architecture. Buildroot has no cortex-m33, and it does not need one: ARMv8-M
# Mainline is a superset of ARMv7E-M, so cortex-m4 output runs unmodified on the
# RP2350's M33. BR2_ARM_CPU_ARMV7M is what selects BR2_ARCH_HAS_FDPIC_SUPPORT.
BR2_arm=y
BR2_cortex_m4=y

# FDPIC, not FLAT. This is the decision F8 turned into a requirement: bFLT
# copies each binary's text into RAM per process and needs one contiguous block
# for text+data together, which is why the RISC-V smoke test could not start a
# single external command in 8 MB. FDPIC separates the segments and shares one
# libc.so across every process.
BR2_BINFMT_FDPIC=y

BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
# The toolchain's kernel headers must match the kernel we build, and Buildroot
# defaults to 2.6.x. Left alone it builds an entire FDPIC toolchain and then
# refuses: "Incorrect selection of kernel headers: expected 2.6.x, got 6.15.x".
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_15=y
# NPTL, which is available here despite the missing MMU:
#
#   config BR2_PTHREADS_NATIVE
#       depends on BR2_USE_MMU || ((BR2_arm || BR2_armeb) && BR2_BINFMT_FDPIC)
#
# ARM plus FDPIC is exactly this configuration, so uClibc's native threads are
# explicitly supported and nothing needs patching to get them. Worth stating
# because it is surprising: threads on a machine with no address translation
# sound like they should be the hard part, and it is fork() that is impossible,
# not threads. glib2 -- and so mc -- needs threads and would otherwise be out of
# reach for a reason that does not actually apply.
# NPTL, which needs two things this board did not have.
#
# Buildroot offers it (`depends on BR2_USE_MMU || ((BR2_arm || BR2_armeb) &&
# BR2_BINFMT_FDPIC)`), and ARM plus FDPIC is this configuration -- but every
# uClibc mutex begins with a compare-exchange, and LDREX/STREX have no exclusive
# monitor covering PSRAM on this chip (F6). STREX there never succeeds, so the
# retry loop spins forever and the first process to take a lock stops the
# machine before printing anything. That is F29.
#
# Fixed, not worked around:
#
#   linux 0010    __ARM_NR_cmpxchg, a compare-exchange the kernel performs with
#                 interrupts masked -- the same trick it already uses for its
#                 own atomics, which userspace cannot do for itself
#   uclibc 0002   the ARM compare-exchange macro calls it on M-profile, which
#                 covers the whole library because include/atomic.h builds
#                 every other atomic on that one macro
#   CONFIG_FUTEX  needed once locks can actually be contended (F28)
#
# Verified before this was switched on, by calling the syscall directly from a
# userspace built without it: 20000 compare-exchange increments arriving at
# exactly 20000. See board/frank/core2-proto/castest.c.
BR2_PTHREADS_NATIVE=y
BR2_OPTIMIZE_S=y

# Stripping is done by our own post-build script, not by BR2_STRIP_strip:
# that option `depends on BR2_BINFMT_ELF` and we select BR2_BINFMT_FDPIC, so
# Buildroot's strip step is unavailable and silently absent from .config.
# See board/frank/core2-proto/post-build.sh for why it matters on NOMMU.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FRANK_LINUX_PATH)/board/frank/core2-proto/post-build.sh"

# romfs, built by post-image because Buildroot has no romfs target. This is the
# image the board actually executes from -- see the script for why not cramfs.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FRANK_LINUX_PATH)/board/frank/core2-proto/post-image.sh"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.15"
BR2_LINUX_KERNEL_DEFCONFIG="rp2350"
# A raw Image, not vmlinux or zImage. afboot-rp2350 copies it to a fixed address
# in PSRAM and branches to the start, so it wants bytes rather than an ELF -- and
# there is no decompressor on the far side to unpack a zImage.
#
# Via the custom target rather than BR2_LINUX_KERNEL_IMAGE, which `depends on
# BR2_aarch64 || BR2_riscv` and is simply unavailable on 32-bit ARM; setting it
# is silently ignored and you get the ARM default of zImage. Same mechanism the
# STM32 NOMMU configs use for xipImage.
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="Image"
BR2_LINUX_KERNEL_IMAGE_NAME="Image"

BR2_LINUX_KERNEL_DTS_SUPPORT=y
# In-tree, added by patch 0005. Buildroot's custom-DTS path copies files to
# arch/arm/boot/dts/ where, since the per-vendor reorganisation, nothing knows
# how to build them.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="frank/frank-core2-proto-slave"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_FRANK_LINUX_PATH)/patches"

# It is not Buildroot, it is this board. The stock banner and hostname say
# "buildroot", which is the build system rather than the machine.
#
# The banner itself is written by post-build.sh from version.txt, so the version
# lives in one place rather than being duplicated as a literal here.
BR2_TARGET_GENERIC_HOSTNAME="frank"

# Userspace: BusyBox in a romfs in flash, mounted as root and executed in place.
#
# Not an initramfs. That is the obvious choice on a machine with no storage and
# it is what this used to do, but it means the kernel unpacks the whole rootfs
# into RAM at boot and then never gives it back -- on a board with 8 MB, 1.1 MB
# of it spent holding a second copy of files that are already in flash.
#
# romfs on an MTD hands the same files back as a direct mapping instead, so a
# binary's text is fetched from flash as it executes and occupies no RAM at all.
# 384 kB of BusyBox costs nothing to run. See post-image.sh for how the image is
# built and 0004's ROMFS block for what the kernel needs to mount it.
#
# The cost is that the root is read-only, which the skeleton is not expecting;
# post-build.sh adjusts inittab and fstab for it.
# BR2_TARGET_ROOTFS_INITRAMFS is not set
# BR2_TARGET_ROOTFS_TAR is not set

# Locale and wide characters, which are a toolchain rebuild rather than package
# options.
#
# Wide characters are needed by ncurses' wide build and, downstream, by nano and
# mc -- Buildroot guards both with `depends on BR2_USE_WCHAR`, and uClibc has it
# off by default. LOCALE selects WCHAR, so this covers both.
#
# Locale is here for a second reason: it is what makes uClibc provide iconv().
# Without it, glib's `select BR2_PACKAGE_LIBICONV if !BR2_ENABLE_LOCALE` pulls
# in GNU libiconv, whose staging install does not reliably leave iconv.h in the
# sysroot here -- glib then configures or compiles depending on the order things
# happened in, which is not a build, it is a coin toss:
#
#   ../glib/gconvert.c:27:10: fatal error: iconv.h: No such file or directory
#
# A C library that has iconv removes the package, the question and the failure
# mode together, and a file manager on a UTF-8 terminal wanted the locale
# anyway.
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y

# ncurses, for anything that draws a screen rather than a line.
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y

# BusyBox applets the NOMMU default leaves out -- vi, less, awk, find, tar and
# the memory tools. See the fragment for why each one is here.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FRANK_LINUX_PATH)/board/frank/core2-proto/busybox.fragment"

# nano, built full rather than --enable-tiny.
#
# Upstream Buildroot forces tiny on NOMMU (`select BR2_PACKAGE_NANO_TINY if
# !BR2_USE_MMU`, commented "full version uses fork()"), which throws away undo,
# colour syntax, line numbers and nanorc to avoid a handful of call sites. We
# patch the call sites instead -- see buildroot-patches/ for the Config.in
# change and br-external/patches/nano/ for the sites themselves.
BR2_PACKAGE_NANO=y
# BR2_PACKAGE_NANO_TINY is not set

# Midnight Commander, with ncurses rather than slang and no subshell.
#
# The subshell is off because it has not been ported, not because it cannot be:
# mc's subshell child execs a shell after nothing but syscalls, and would work
# under vfork if it did not allocate first. See the note in mc.mk, carried by
# buildroot-patches/0003. Background file operations are the part that really
# does need a copy of a running mc, and they stay off.
#
# Without either, the panels, the internal viewer and the internal editor all
# work, external commands run through posix_spawn, and so do the popen-based
# paths -- which is what mc is wanted for here.
#
# It lands in flash rather than RAM, which is what makes it affordable at all --
# mc plus glib is several MB, and on an 8 MB machine that is the whole budget if
# it has to be resident. Executed in place it costs only its data.
BR2_PACKAGE_MC=y

# TERM, PATH and the prompt. profile.d rather than replacing /etc/profile, so
# Buildroot's skeleton keeps working.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FRANK_LINUX_PATH)/board/frank/core2-proto/rootfs-overlay"
