# Kernel fragment for the QEMU ARMv7-M target.
#
# The board port will add a machine; everything here is what the *architecture*
# needs, and is shared with the RP2350 target.

# NOMMU. ARM_SINGLE_ARMV7M is `def_bool !MMU` and selects ARM_NVIC + CPU_V7M.
# CONFIG_MMU is not set

# Uniprocessor, and this is load-bearing rather than a simplification: with no
# usable exclusive monitor we replace LDREX/STREX with interrupt masking, which
# is only atomic because nothing else runs on this core. See docs/atomics-port.md.
# CONFIG_SMP is not set

# The MPU. Mainline compiles pmsa-v7.o and pmsa-v8.o together and selects at
# runtime; the RP2350's M33 reports PMSAv8, unified, 8 regions (hw-findings F6).
CONFIG_ARM_MPU=y

# FDPIC userspace with shared libraries, instead of bFLT.
#
# mps2_defconfig sets CONFIG_BINFMT_FLAT=y, and that is precisely the format
# F8 measured failing: bFLT needs one contiguous block per process for text and
# data together -- 512 kB for BusyBox -- which 8 MB of fragmented RAM could not
# supply, so the RISC-V smoke test reached a shell that could not start a single
# external command. Turn it off explicitly rather than relying on the FDPIC
# option to displace it.
CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_BINFMT_SCRIPT=y
# CONFIG_BINFMT_FLAT is not set

# MPS2's own UART, which is what QEMU's mps2-an385 provides. PL011 above is for
# the RP2350, whose UART is a PL011; carrying both keeps one fragment serving
# both targets.
CONFIG_SERIAL_MPS2_UART=y
CONFIG_SERIAL_MPS2_UART_CONSOLE=y

# Console
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Keep it small: 8 MB of RAM is the budget, and F8 showed what happens when the
# kernel image eats it.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DEBUG_INFO is not set
