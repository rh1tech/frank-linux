+# SPDX-License-Identifier: GPL-2.0-only
+menuconfig ARCH_RP2350
+	bool "Raspberry Pi RP2350 (Cortex-M33)"
+	depends on ARM_SINGLE_ARMV7M
+	select ARM_NO_EXCLUSIVES
+	select CLKSRC_RP2350
+	select FRANK_RING_CONSOLE
+	help
+	  Support for the Arm side of the Raspberry Pi RP2350, a dual
+	  Cortex-M33 with no MMU, running Linux out of external QSPI PSRAM.
+
+	  ARM_NO_EXCLUSIVES is selected rather than offered: LDREX/STREX on
+	  this SoC work only in the internal SRAM and never succeed in the
+	  PSRAM that holds system RAM, and they fail silently rather than
+	  faulting. A kernel built without it does not crash, it livelocks in
+	  the first cmpxchg with no diagnostic at all.
+
+if ARCH_RP2350
+
+config CLKSRC_RP2350
+	bool "RP2350 TIMER0 clocksource and clockevent"
+	select CLKSRC_MMIO
+	help
+	  TIMER0 is a 64-bit microsecond counter with four alarms. The kernel
+	  needs both a clocksource and a clockevent, and ARMV7M_SYSTICK
+	  provides only the former.
+
+config FRANK_RING_CONSOLE
+	bool "Console over the core-1 SRAM ring"
+	select SERIAL_CORE
+	select SERIAL_CORE_CONSOLE
+	help
+	  Console served by the second core rather than by a UART.
+
+	  The RP2350's USB controller has no Linux driver. On the FRANK Core 2
+	  Proto the slave half has no wired UART either, so core 1 runs a
+	  TinyUSB CDC device and exchanges bytes with the kernel through two
+	  single-producer/single-consumer rings in SRAM. This driver is the
+	  kernel end of that: a polled tty with no knowledge of USB at all.
+
+endif
