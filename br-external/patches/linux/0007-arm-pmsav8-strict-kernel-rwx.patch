--- a/arch/arm/mm/pmsa-v8.c
+++ b/arch/arm/mm/pmsa-v8.c
@@ -237,6 +237,141 @@
 }
 #endif
 
+#ifdef CONFIG_STRICT_KERNEL_RWX
+/*
+ * Split the kernel's region in two: text and rodata read-only and executable,
+ * everything after them writable and never executable.
+ *
+ * None of this can be __init or use __initdata -- mark_rodata_ro() runs after
+ * free_initmem(), so anything in .init has already been given back.
+ */
+/* First disabled region at or after `from`. Regions are claimed by programming
+ * them, which happens later with the MPU off, so callers asking for more than
+ * one have to step past the ones they have already picked. */
+static int pmsav8_free_region(unsigned int from)
+{
+	unsigned int max = (read_cpuid_mputype() & MPUIR_DREGION_SZMASK)
+			   >> MPUIR_DREGION;
+	unsigned int i;
+
+	for (i = from; i < max && i < MPU_MAX_REGIONS; i++) {
+		prsel_write(i);
+		isb();
+		if (!(prlar_read() & PMSAv8_LAR_EN))
+			return i;
+	}
+	return -ENOSPC;
+}
+
+static void pmsav8_program(unsigned int number, u32 bar, u32 lar)
+{
+	prsel_write(number);
+	isb();
+	prbar_write(bar);
+	prlar_write(lar);
+
+	mpu_rgn_info.rgns[number].prbar = bar;
+	mpu_rgn_info.rgns[number].prlar = lar;
+}
+
+void pmsav8_mark_rodata_ro(void)
+{
+	phys_addr_t ro_start = __pa(KERNEL_START);
+	phys_addr_t ro_end = __pa(__init_begin);
+	phys_addr_t init_end = __pa(__init_end);
+	phys_addr_t rw_end = __pa(KERNEL_END);
+	void __iomem *scb = BASEADDR_V7M_SCB;
+	unsigned long flags;
+	int rw_rgn, init_rgn;
+	u32 ctrl;
+
+	/*
+	 * The boundary is __init_begin rather than __end_rodata. Everything
+	 * below it is text, rodata and the tables between them; everything at
+	 * or above it is the init sections (already freed) followed by data and
+	 * bss. Splitting at __end_rodata would leave those tables in the
+	 * writable half for no gain.
+	 */
+	rw_rgn = pmsav8_free_region(0);
+	if (rw_rgn < 0) {
+		pr_warn("MPU: no free region, kernel text left writable\n");
+		return;
+	}
+
+	/*
+	 * A third region, for the __init sections that free_initmem() has just
+	 * handed back to the page allocator.
+	 *
+	 * They sit between the kernel's text and its data, inside the region
+	 * that denies user mode any access -- correct while they held init code,
+	 * and wrong the moment they became free pages. On NOMMU those pages go
+	 * straight into the same pool userspace allocates from, so a process
+	 * eventually receives memory it is not allowed to touch and dies on its
+	 * own heap. With a 1.6 MB initramfs that is 936 kB of unusable memory
+	 * and the very first process is the one that gets it:
+	 *
+	 *   Kernel panic - not syncing: Attempted to kill init! exitcode=0x0b
+	 *
+	 * which says SIGSEGV and nothing at all about the MPU.
+	 */
+	init_rgn = pmsav8_free_region(rw_rgn + 1);
+	if (init_rgn < 0) {
+		pr_warn("MPU: no free region for freed __init memory\n");
+		return;
+	}
+
+	/*
+	 * The MPU goes off across the change.
+	 *
+	 * Two regions have to be rewritten and there is no way to do it in one
+	 * step. Shrinking the kernel region first leaves data and bss unmapped,
+	 * and the next stack access faults; writing the new region first leaves
+	 * the two overlapping, which is UNPREDICTABLE on ARMv8-M. With the MPU
+	 * disabled the default map applies, so neither window exists. Interrupts
+	 * are off so nothing runs unprotected for longer than these few stores.
+	 */
+	local_irq_save(flags);
+
+	ctrl = readl_relaxed(scb + MPU_CTRL);
+	writel_relaxed(ctrl & ~MPU_CTRL_ENABLE, scb + MPU_CTRL);
+	dsb();
+	isb();
+
+	/* freed __init memory: ordinary RAM again, reachable by user mode */
+	pmsav8_program(init_rgn,
+		       ro_end | PMSAv8_AP_PL1RW_PL0RW | PMSAv8_RGN_SHARED,
+		       ((init_end - 1) & ~(PMSAv8_MINALIGN - 1)) |
+				PMSAv8_LAR_IDX(PMSAv8_RGN_NORMAL) | PMSAv8_LAR_EN);
+
+	/* data and bss: writable, never executable */
+	pmsav8_program(rw_rgn,
+		       init_end | PMSAv8_AP_PL1RW_PL0NA | PMSAv8_RGN_SHARED |
+				PMSAv8_BAR_XN,
+		       ((rw_end - 1) & ~(PMSAv8_MINALIGN - 1)) |
+				PMSAv8_LAR_IDX(PMSAv8_RGN_NORMAL) | PMSAv8_LAR_EN);
+
+	/* text and rodata: executable, read-only */
+	pmsav8_program(PMSAv8_KERNEL_REGION,
+		       ro_start | PMSAv8_AP_PL1RO_PL0NA | PMSAv8_RGN_SHARED,
+		       ((ro_end - 1) & ~(PMSAv8_MINALIGN - 1)) |
+				PMSAv8_LAR_IDX(PMSAv8_RGN_NORMAL) | PMSAv8_LAR_EN);
+
+	dsb();
+	writel_relaxed(ctrl, scb + MPU_CTRL);
+	dsb();
+	isb();
+
+	local_irq_restore(flags);
+
+	mpu_rgn_info.used += 2;
+
+	pr_info("Kernel text %pa-%pa read-only, data %pa-%pa non-executable\n",
+		&ro_start, &ro_end, &init_end, &rw_end);
+	pr_info("Freed __init %pa-%pa returned to user-accessible memory\n",
+		&ro_end, &init_end);
+}
+#endif /* CONFIG_STRICT_KERNEL_RWX */
+
 void __init pmsav8_setup(void)
 {
 	int i, err = 0;
--- a/arch/arm/mm/nommu.c
+++ b/arch/arm/mm/nommu.c
@@ -126,6 +126,27 @@
 	}
 }
 
+#ifdef CONFIG_STRICT_KERNEL_RWX
+/*
+ * Only PMSAv8 implements this. On PMSAv7 say so rather than returning quietly:
+ * init/main.c has already printed nothing at all in that case, and a silent
+ * no-op here would leave the impression the kernel is protected when it is not.
+ */
+void mark_rodata_ro(void)
+{
+	unsigned long pmsa = read_cpuid_ext(CPUID_EXT_MMFR0) & MMFR0_PMSA;
+
+	switch (pmsa) {
+	case MMFR0_PMSAv8:
+		pmsav8_mark_rodata_ro();
+		break;
+	default:
+		pr_warn("Kernel memory protection not implemented for this MPU\n");
+		break;
+	}
+}
+#endif
+
 static void __init mpu_setup(void)
 {
 	unsigned long pmsa = read_cpuid_ext(CPUID_EXT_MMFR0) & MMFR0_PMSA;
