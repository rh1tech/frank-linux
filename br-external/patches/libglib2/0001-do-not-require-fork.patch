--- a/glib/gthread-posix.c
+++ b/glib/gthread-posix.c
@@ -74,8 +74,25 @@
 #include <sys/syscall.h>
 #endif
 
+/* The native mutex is built directly out of __atomic builtins and a futex,
+ * bypassing g_atomic_* entirely -- so it needs the atomics to be lock-free, not
+ * merely present. G_ATOMIC_LOCK_FREE is what says so, and when it is false the
+ * emulated g_atomic_* operations are themselves implemented with a mutex, which
+ * makes building a mutex out of them circular.
+ *
+ * On the target this matters for it is worse than circular: the atomics are not
+ * emulated because they are slow, they are emulated because LDREX/STREX have no
+ * exclusive monitor covering the memory the system runs from and the retry loop
+ * never terminates. g_mutex_lock_slowpath(), g_mutex_unlock() and
+ * g_mutex_trylock() were the last six exclusive instructions left in the
+ * library, and any one of them hangs the process for good.
+ *
+ * Without USE_NATIVE_MUTEX, GMutex is pthread_mutex_t, which on that target is
+ * implemented with a kernel-assisted compare-exchange and works.
+ */
 #if (defined(HAVE_FUTEX) || defined(HAVE_FUTEX_TIME64)) && \
-    (defined(HAVE_STDATOMIC_H) || defined(__ATOMIC_SEQ_CST))
+    (defined(HAVE_STDATOMIC_H) || defined(__ATOMIC_SEQ_CST)) && \
+    defined(G_ATOMIC_LOCK_FREE)
 #define USE_NATIVE_MUTEX
 #endif
 
