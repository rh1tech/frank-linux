--- a/glib/gtestutils.c
+++ b/glib/gtestutils.c
@@ -3941,8 +3941,19 @@
       errsv = errno;
       g_error ("failed to create pipes to fork test program: %s", g_strerror (errsv));
     }
+#ifdef HAVE_FORK
   test_trap_last_pid = fork ();
   errsv = errno;
+#else
+  /* g_test_trap_fork() has been deprecated since 2.38 in favour of
+   * g_test_trap_subprocess(), which re-executes the test binary rather than
+   * duplicating the process -- and re-execution is the only thing available on
+   * a system without fork(). Report the failure the way a failed fork() is
+   * reported here, which is fatal: a test that believes it forked and did not
+   * would go on to run the child's assertions in the parent. */
+  test_trap_last_pid = -1;
+  errsv = ENOSYS;
+#endif
   if (test_trap_last_pid < 0)
     g_error ("failed to fork test program: %s", g_strerror (errsv));
   if (test_trap_last_pid == 0)  /* child */
